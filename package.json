{
  "name": "jvmsrc",
  "version": "0.1.0",
  "main": "./dist/public-api.js",
  "exports": {
    ".": "./dist/public-api.js"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "jvmsrc": "./dist/cli.js"
  },
  "files": [
    "dist",
    "resources"
  ],
  "scripts": {
    "dev:cli": "bun run src/cli.ts",
    "dev:mcp": "bun run src/mcp.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "build": "bun build ./src/cli.ts ./src/mcp.ts ./src/public-api.ts --outdir ./dist --target node --format esm",
    "setup:cfr": "bun run scripts/fetch-cfr.ts",
    "prepack": "bun run typecheck && bun run build && bun run scripts/validate-bundled-resources.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^25.7.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "env-paths": "^4.0.0",
    "fflate": "^0.8.2"
  }
}
